# PromptShield AI — backend environment
# Copy this file to `.env` and fill in values. NEVER commit a real `.env`.

# Optional: enables the AI Investigation feature (Gemini).
# The key is read ONLY by the backend. It is never sent to the browser,
# never written to logs, and never stored in the application database.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: model override (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Optional: backend port (default: 8787)
PORT=8787

# Optional: rate-limit overrides (requests per window).
# Limits are PER-PROCESS and in-memory — suitable for a single-instance
# deployment only, not as a distributed limit.
# PS_RL_INVESTIGATE_MAX=5   # per minute
# PS_RL_RUNS_MAX=30         # per minute
# PS_RL_RESET_MAX=5         # per hour

# Optional: reset authorization. When set, POST /api/reset additionally
# requires header `x-admin-token: <value>`. When unset, reset is restricted
# to loopback clients only (the intended local-demo boundary).
# PS_ADMIN_TOKEN=

# Optional: Gemini investigation timeout in ms (default: 12000)
# PS_GEMINI_TIMEOUT_MS=12000
