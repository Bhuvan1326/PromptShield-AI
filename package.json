{
  "name": "promptshield-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "PromptShield AI — defensive AI application security testing platform. Test the attack. Measure the defense.",
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "tsx server/index.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@google/genai": "1.20.0",
    "@radix-ui/react-dialog": "1.1.2",
    "clsx": "2.1.1",
    "dotenv": "16.4.7",
    "express": "^4.22.3",
    "lucide-react": "0.462.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^6.30.6",
    "recharts": "2.15.0",
    "tsx": "^4.23.15",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/express": "4.17.21",
    "@types/node": "22.10.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/supertest": "6.0.2",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "10.4.20",
    "concurrently": "9.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "postcss": "^8.5.31",
    "supertest": "^7.3.1",
    "tailwindcss": "^3.4.19",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
